rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resource) {
      return signedIn() && resource.data.owner_uid == request.auth.uid;
    }

    match /partner_products/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /partners/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /parts/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'active' || owns(resource);
      allow create: if signedIn()
                    && request.resource.data.owner_uid == request.auth.uid
                    && !request.resource.data.keys().hasAny([
                      'sponsored', 'partner_tier', 'partner_id', 'commission_pct'
                    ]);
      // The owner may edit a listing but not take it over or make it sponsored.
      allow update: if owns(resource)
                    && request.resource.data.owner_uid == resource.data.owner_uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'sponsored', 'partner_tier', 'partner_id', 'commission_pct'
                    ]);
      allow delete: if owns(resource);
    }

    match /part_compatibility/{id} {
      allow read: if true;
      allow write: if false;
    }

    // One document per cart line (CART_ITEM) with the owner's uid. Only the
    // backend writes it, so prices and availability are always checked.
    match /carts/{lineId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Orders are created and confirmed only by the backend (checkout + Stripe webhook).
    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Stripe webhook idempotency markers: backend only.
    match /stripe_events/{eventId} {
      allow read, write: if false;
    }
  }
}
