# Copy this file to .env for local development and fill in the values.
# Never commit a .env file or real provider keys: the repository is public.
# In production these variables are set in the Vercel project (Settings ->
# Environment Variables) and this file is not used.

# --- AI providers ---------------------------------------------------------
# Required: every call to the AI agent uses OpenRouter.
OPENROUTER_API_KEY=
# Optional: OpenRouter model id. Defaults to the free router.
OPENROUTER_MODEL=openrouter/free
# Add these when their integrations are enabled.
OPENAI_API_KEY=
KIE_API_KEY=

# --- Server ---------------------------------------------------------------
# "dev" or "prod" (prod emits JSON logs).
HODOWO_ENV=dev
# Comma-separated browser origins allowed by CORS. Never use "*".
ALLOWED_ORIGINS=http://localhost:3000,https://app.hodowo.com
# Rate limit applied to the AI endpoints, per client IP.
AI_RATE_LIMIT=20/minute

# --- Authentication (JWT) -------------------------------------------------
# Set exactly one of the two key sources.
JWT_SECRET=
JWT_JWKS_URL=
