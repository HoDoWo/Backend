# Copy this file to .env for local development and fill in the values.
# Never commit a .env file or real provider keys: the repository is public.
# In production these variables are set in the Vercel project (Settings ->
# Environment Variables) and this file is not used.

# --- AI providers ---------------------------------------------------------
# Required: every call to the AI agent uses OpenRouter.
OPENROUTER_API_KEY=
# Optional: OpenRouter model id. Defaults to the free router.
OPENROUTER_MODEL=openrouter/free
# Add these when their integrations are enabled.
OPENAI_API_KEY=
KIE_API_KEY=

# --- Server ---------------------------------------------------------------
# "dev" or "prod" (prod emits JSON logs).
HODOWO_ENV=dev
# Comma-separated browser origins allowed by CORS. Never use "*".
ALLOWED_ORIGINS=http://localhost:3000,https://app.hodowo.com
# Rate limit applied to the AI endpoints, per client IP.
AI_RATE_LIMIT=20/minute
FORUM_RATE_LIMIT=10/minute
MESSAGES_RATE_LIMIT=30/minute

# --- Authentication (JWT) -------------------------------------------------
# Set exactly one of the two key sources.
JWT_SECRET=
JWT_JWKS_URL=

# --- Firebase / Firestore persistence ------------------------------------

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Marketplace payments (Stripe, test mode only) ------------------------
# Leave both empty to run the checkout in simulated mode (orders are recorded
# and flagged "simulated"). Only test keys are accepted: sk_test_... / rk_test_...
# The publishable key (pk_test_...) goes in the Android app, never here.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally it is printed by
# `stripe listen --forward-to localhost:8000/api/marketplace/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=eur
