rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(resource) {
      return signedIn() && resource.data.owner_uid == request.auth.uid;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The user's own data, written by the app: profile (name, photo), registered
    // appliances, chats and their messages, saved manuals, bookmarks and ratings.
    // Firestore keeps a copy on the phone, so it works offline and syncs when the
    // user signs in on another phone. Nobody else can read it.
    match /users/{uid} {
      allow read, write: if isUser(uid);

      match /{document=**} {
        allow read, write: if isUser(uid);
      }
    }

    // Answer ratings of all users, for the team. The app only adds its own;
    // nobody reads them from the app.
    match /ratings/{ratingId} {
      allow read, delete: if false;
      allow create, update: if signedIn()
                            && request.resource.data.userId == request.auth.uid
                            && ratingId == request.auth.uid + '_' + string(request.resource.data.messageId);
    }

    match /partner_products/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /partners/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /parts/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /listings/{id} {
      allow read: if resource.data.status == 'active' || owns(resource);
      allow create: if signedIn()
                    && request.resource.data.owner_uid == request.auth.uid
                    && !request.resource.data.keys().hasAny([
                      'sponsored', 'partner_tier', 'partner_id', 'commission_pct'
                    ]);
      // The owner may edit a listing but not take it over or make it sponsored.
      allow update: if owns(resource)
                    && request.resource.data.owner_uid == resource.data.owner_uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'sponsored', 'partner_tier', 'partner_id', 'commission_pct'
                    ]);
      allow delete: if owns(resource);
    }

    match /part_compatibility/{id} {
      allow read: if true;
      allow write: if false;
    }

    // One document per cart line (CART_ITEM) with the owner's uid. Only the
    // backend writes it, so prices and availability are always checked.
    match /carts/{lineId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Orders are created and confirmed only by the backend (checkout + Stripe webhook).
    match /orders/{orderId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Stripe webhook idempotency markers: backend only.
    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    // Appliance forum (#44): only the backend reads and writes it, so hidden posts,
    // uids and report counts never reach the app, and badges and votes
    // cannot be forged.
    match /forum_threads/{threadId} {
      allow read, write: if false;

      match /replies/{replyId} {
        allow read, write: if false;
      }
    }

    match /forum_votes/{voteId} {
      allow read, write: if false;
    }

    match /forum_reports/{reportId} {
      allow read, write: if false;
    }

    // Buyer-seller conversations and offers: only the backend reads and writes
    // them, so the other person's uid never reaches the app and an offer
    // cannot be accepted by the one who made it.
    match /conversations/{conversationId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }
  }
}
